{
  "name": "loopar-install",
  "version": "1.3.0",
  "description": "Official Loopar Framework installer CLI — Node 22+, Git clone, Yarn 4.x (Corepack), guided or non-interactive mode",
  "type": "module",
  "main": "index.js",
  "bin": {
    "loopar-install": "./index.js",
    "loopar": "./index.js"
  },
  "scripts": {
    "test": "node --check index.js && node index.js doctor && node index.js --help",
    "test:smoke": "node index.js .tmp-loopar-test --yes --skip-install --skip-start --quiet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphabit-technology/install-loopar.git"
  },
  "keywords": [
    "loopar",
    "loopar-install",
    "create-loopar",
    "framework",
    "multitenancy",
    "multitenant",
    "node",
    "npm",
    "yarn",
    "installer",
    "cli"
  ],
  "author": "Alfredo Ramirez <alfredrz2012@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alphabit-technology/install-loopar/issues"
  },
  "homepage": "https://loopar.build",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "inquirer": "^9.2.12",
    "chalk": "^5.3.0",
    "ora": "^7.0.1"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ]
}
